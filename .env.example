# Copy to .env and fill in. .env is gitignored; never commit it.

# Helios (sweph REST API) and Neo4j — used by stella_server.py / stella_config.py
SWEPH_API_BASE=http://baratie:3000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=

# Remote MCP endpoint (stella_http.py behind Tailscale Funnel + GitHub OAuth)
STELLA_PUBLIC_URL=https://<magicdns-name>.ts.net   # port 443; claude.ai will not dial other ports
STELLA_ALLOWED_GH_LOGINS=<your-github-login>
STELLA_HTTP_PORT=8811
STELLA_HTTP_DENY_TOOLS=
STELLA_GH_CLIENT_ID=
STELLA_GH_CLIENT_SECRET=
